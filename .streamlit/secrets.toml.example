# Copy these values into Streamlit Community Cloud → App settings → Secrets.
# Never commit a real `secrets.toml` file.

APP_PASSWORD = "replace-with-a-long-random-password"
OPENAI_API_KEY = "replace-with-your-api-key"
OPENAI_MODEL = "gpt-5.5"

SMTP_HOST = "smtp.feishu.cn"
SMTP_PORT = 465
SMTP_USER = "your-email@example.com"
SMTP_PASSWORD = "replace-with-your-smtp-authorization-code"
SMTP_SENDER_NAME = "Your Name"
SMTP_USE_SSL = true
